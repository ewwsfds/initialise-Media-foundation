#include <windows.h>
#include <mfapi.h>
#include <mfidl.h>
#include <mfreadwrite.h>
#include <mfobjects.h>
#include <mferror.h>

#include <iostream>

#pragma comment(lib, "mfplat.lib")
#pragma comment(lib, "mfreadwrite.lib")
#pragma comment(lib, "mfuuid.lib")
#pragma comment(lib, "mf.lib")

int main()
{
    HRESULT hr = S_OK;

    hr = MFStartup(MF_VERSION);
    if (FAILED(hr)) return -1;

    IMFSourceReader* reader = nullptr;
    hr = MFCreateSourceReaderFromURL(L"test.mp4", NULL, &reader);
    if (FAILED(hr)) return -1;

    // Force NV12 output
    IMFMediaType* mediaType = nullptr;
    MFCreateMediaType(&mediaType);
    mediaType->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
    mediaType->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_NV12);

    reader->SetCurrentMediaType(
        MF_SOURCE_READER_FIRST_VIDEO_STREAM,
        NULL,
        mediaType
    );
    mediaType->Release();

    // Get actual negotiated type
    IMFMediaType* actualType = nullptr;
    reader->GetCurrentMediaType(
        MF_SOURCE_READER_FIRST_VIDEO_STREAM,
        &actualType
    );

    // -------- READ WIDTH / HEIGHT / FPS --------
    UINT32 width = 0, height = 0;
    UINT32 fpsNum = 0, fpsDen = 0;

    MFGetAttributeSize(actualType, MF_MT_FRAME_SIZE, &width, &height);
    MFGetAttributeRatio(actualType, MF_MT_FRAME_RATE, &fpsNum, &fpsDen);

    std::cout << "Width: " << width << " Height: " << height << "\n";
    std::cout << "FPS: " << fpsNum << "/" << fpsDen << "\n";

    // ================== ENCODER SETUP ==================
    IMFSinkWriter* writer = nullptr;
    DWORD streamIndex = 0;

    MFCreateSinkWriterFromURL(L"output.mp4", NULL, NULL, &writer);

    IMFMediaType* outType = nullptr;
    MFCreateMediaType(&outType);
    outType->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
    outType->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_H264);
    outType->SetUINT32(MF_MT_AVG_BITRATE, 8000000);
    outType->SetUINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);

    MFSetAttributeSize(outType, MF_MT_FRAME_SIZE, width, height);
    MFSetAttributeRatio(outType, MF_MT_FRAME_RATE, fpsNum, fpsDen);
    MFSetAttributeRatio(outType, MF_MT_PIXEL_ASPECT_RATIO, 1, 1);

    writer->AddStream(outType, &streamIndex);
    outType->Release();

    IMFMediaType* inType = nullptr;
    MFCreateMediaType(&inType);
    inType->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
    inType->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_NV12);
    inType->SetUINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);

    MFSetAttributeSize(inType, MF_MT_FRAME_SIZE, width, height);
    MFSetAttributeRatio(inType, MF_MT_FRAME_RATE, fpsNum, fpsDen);
    MFSetAttributeRatio(inType, MF_MT_PIXEL_ASPECT_RATIO, 1, 1);

    writer->SetInputMediaType(streamIndex, inType, NULL);
    inType->Release();

    writer->BeginWriting();
    // ================== END ENCODER SETUP ==================

    actualType->Release();

    // Timing
    LONGLONG frameTime = 0;
    LONGLONG frameDuration = (fpsDen != 0) ? (10000000LL * fpsDen / fpsNum) : 0;

    while (true)
    {
        IMFSample* sample = nullptr;
        DWORD flags = 0;

        hr = reader->ReadSample(
            MF_SOURCE_READER_FIRST_VIDEO_STREAM,
            0,
            NULL,
            &flags,
            NULL,
            &sample
        );

        if (FAILED(hr)) break;

        if (flags & MF_SOURCE_READERF_ENDOFSTREAM)
            break;

        if (sample)
        {
            // Set timestamps for encoder
            sample->SetSampleTime(frameTime);
            sample->SetSampleDuration(frameDuration);

            writer->WriteSample(streamIndex, sample);

            frameTime += frameDuration;

            sample->Release();
        }
    }

    writer->Finalize();
    writer->Release();

    reader->Release();
    MFShutdown();

    return 0;
}
